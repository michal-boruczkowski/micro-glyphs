{
  "name": "micro-glyphs",
  "version": "0.1.0",
  "description": "Micro glyphs React component library",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/micro-glyphs.umd.cjs",
  "module": "./dist/micro-glyphs.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/micro-glyphs.js",
      "require": "./dist/micro-glyphs.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "vitest run --update",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "oxlint",
    "lint:fix": "oxfmt"
  },
  "dependencies": {
    "d3": "7.9.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.5.6",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/d3": "7.4.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.5.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "react": "18.0.0 || 19.0.0",
    "react-dom": "18.0.0 || 19.0.0"
  }
}
