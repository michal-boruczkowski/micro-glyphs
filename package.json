{
  "name": "micro-glyphs",
  "version": "0.1.0",
  "description": "Micro glyphs React component library",
  "type": "module",
  "main": "./dist/micro-glyphs.umd.cjs",
  "module": "./dist/micro-glyphs.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/micro-glyphs.js",
      "require": "./dist/micro-glyphs.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "18.0.0 || 19.0.0",
    "react-dom": "18.0.0 || 19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "8.6.14",
    "typescript": "6.0.3",
    "vite": "6.2.0",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.10"
  }
}